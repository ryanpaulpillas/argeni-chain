# One CYVBER node; %i is the node number (cyvber-node@1 … cyvber-node@4).
[Unit]
Description=CYVBER testnet node %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cyvber
Group=cyvber
WorkingDirectory=/opt/cyvber/chain
ExecStart=/usr/bin/node /opt/cyvber/chain/src/cli.js node --config /opt/cyvber/testnet/node-%i.json
Restart=always
RestartSec=3
# Hardening: the node only needs to read its code and write its own data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/cyvber/testnet/data

[Install]
WantedBy=multi-user.target
