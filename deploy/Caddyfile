# Caddy gets and renews HTTPS certificates for these names automatically.
# DNS for each name must point at this server before Caddy starts.

cyvber.com, www.cyvber.com {
	encode gzip
	# The AI assistant (cyvber-assistant service); answers stream as server-sent events.
	handle /api/assistant* {
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
		}
	}
	handle {
		root * /opt/cyvber/site
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Block explorer and JSON API, served by validator node 1.
explorer.cyvber.com, rpc.cyvber.com {
	encode gzip
	reverse_proxy 127.0.0.1:26601
}

faucet.cyvber.com {
	redir https://cyvber.com/#start
}

# The other domains we own forward to the main site, keeping the path.
cyvber.io, www.cyvber.io, cyvber.org, www.cyvber.org, cyvber.co, www.cyvber.co, cyvber.net, www.cyvber.net {
	redir https://cyvber.com{uri} permanent
}
